@model IEnumerable<VianaMotos.Web.Models.Venda>

@{
ViewData["Title"] = "Vendas";


var vendas = Model?.ToList() ?? new List<VianaMotos.Web.Models.Venda>();
var totalVendas = vendas.Count;
var valorTotal = vendas.Sum(v => v.ValorVenda);
var ticketMedio = totalVendas > 0 ? valorTotal / totalVendas : 0;


}

<div class="container-fluid px-0">

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Comercial",
    Title = "Vendas",
    Subtitle = "Acompanhe as negociações e vendas realizadas pela loja.",
    Icon = "bi-receipt",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Nova venda", Url = Url.Action("Create")!, Icon = "bi-plus-lg", IsPrimary = true } }
})

<!-- Indicadores -->
<div class="row g-3 mb-4">

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">
                            Vendas realizadas
                        </span>

                        <h3 class="fw-bold mb-0 mt-2">
                            @totalVendas
                        </h3>
                    </div>

                    <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">
                            Valor vendido
                        </span>

                        <h3 class="fw-bold mb-0 mt-2">
                            @valorTotal.ToString("C")
                        </h3>
                    </div>

                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">
                            Ticket médio
                        </span>

                        <h3 class="fw-bold mb-0 mt-2">
                            @ticketMedio.ToString("C")
                        </h3>
                    </div>

                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Lista de vendas -->
<div class="card border-0 shadow-sm overflow-hidden">

    <div class="card-header bg-white border-bottom px-4 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-1">
                    Histórico de vendas
                </h5>

                <span class="text-muted small">
                    @totalVendas registro@(totalVendas == 1 ? "" : "s") encontrado@(totalVendas == 1 ? "" : "s")
                </span>
            </div>

            <div class="text-muted">
                <i class="bi bi-clock-history fs-5"></i>
            </div>
        </div>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th class="px-4 py-3 text-muted small text-uppercase">
                        Data
                    </th>

                    <th class="py-3 text-muted small text-uppercase">
                        Cliente
                    </th>

                    <th class="py-3 text-muted small text-uppercase">
                        Motocicleta
                    </th>

                    <th class="py-3 text-muted small text-uppercase text-end">
                        Valor
                    </th>

                    <th class="px-4 py-3 text-muted small text-uppercase text-end">
                        Situação
                    </th>
                </tr>
            </thead>

            <tbody>

                @if (vendas.Any())
                {
                    foreach (var item in vendas)
                    {
                        <tr>

                            <td class="px-4 py-3">
                                <div class="fw-semibold">
                                    @item.DataVenda.ToString("dd/MM/yyyy")
                                </div>

                                <small class="text-muted">
                                    Venda realizada
                                </small>
                            </td>

                            <td class="py-3">
                                <div class="d-flex align-items-center gap-3">

                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                                         style="width: 38px; height: 38px;">
                                        <i class="bi bi-person text-secondary"></i>
                                    </div>

                                    <div>
                                        <div class="fw-semibold">
                                            @(item.Cliente?.Nome ?? "Cliente não informado")
                                        </div>

                                        <small class="text-muted">
                                            Comprador
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td class="py-3">
                                <div class="fw-semibold">
                                    @(item.Moto?.Modelo ?? "Moto não informada")
                                </div>

                                <small class="text-muted">
                                    Motocicleta
                                </small>
                            </td>

                            <td class="py-3 text-end">
                                <span class="fw-bold">
                                    @item.ValorVenda.ToString("C")
                                </span>
                            </td>

                            <td class="px-4 py-3 text-end">
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Concluída
                                </span>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5"
                            class="text-center py-5">

                            <div class="mb-3">
                                <i class="bi bi-receipt text-muted"
                                   style="font-size: 2.5rem;"></i>
                            </div>

                            <h5 class="fw-bold">
                                Nenhuma venda registrada
                            </h5>

                            <p class="text-muted mb-3">
                                As vendas realizadas aparecerão aqui.
                            </p>

                            <a asp-action="Create"
                               class="btn btn-danger px-4">
                                <i class="bi bi-plus-lg me-2"></i>
                                Registrar primeira venda
                            </a>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
```

</div>
