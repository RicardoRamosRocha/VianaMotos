@model IEnumerable<VianaMotos.Web.Models.Categoria>
@{
    ViewData["Title"] = "Categorias";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Catálogo",
    Title = "Categorias",
    Subtitle = "Organize as classificações usadas no catálogo de motocicletas.",
    Icon = "bi-collection",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Nova categoria", Url = Url.Action("Create")!, Icon = "bi-plus-lg", IsPrimary = true } }
})


<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ativa</th>
            <th width="200">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Nome</td>
                <td>@categoria.Ativa</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@categoria.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@categoria.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
