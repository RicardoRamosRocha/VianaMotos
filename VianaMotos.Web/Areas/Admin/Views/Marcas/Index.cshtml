@model IEnumerable<VianaMotos.Web.Models.Marca>
@{
    ViewData["Title"] = "Marcas";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Catálogo",
    Title = "Marcas",
    Subtitle = "Gerencie as fabricantes presentes no catálogo da loja.",
    Icon = "bi-tags",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Nova marca", Url = Url.Action("Create")!, Icon = "bi-plus-lg", IsPrimary = true } }
})


<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ativa</th>
            <th width="200">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var marca in Model)
        {
            <tr>
                <td>@marca.Nome</td>
                <td>@marca.Ativa</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@marca.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@marca.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>