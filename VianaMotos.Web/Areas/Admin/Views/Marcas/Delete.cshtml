@model VianaMotos.Web.Models.Marca
@{
    ViewData["Title"] = "Excluir marca";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Catálogo",
    Title = "Excluir marca",
    Subtitle = "Revise os dados antes de remover esta fabricante.",
    Icon = "bi-trash3",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Voltar", Url = Url.Action("Index")!, Icon = "bi-arrow-left", IsPrimary = false } }
})


<div class="alert alert-danger">
    Tem certeza que deseja excluir esta marca?
</div>

<dl class="row">
    <dt class="col-sm-2">
        Nome
    </dt>
    <dd class="col-sm-10">
        @Model.Nome
    </dd>

    <dt class="col-sm-2">
        Ativa
    </dt>
    <dd class="col-sm-10">
        @Model.Ativa
    </dd>
</dl>

<form asp-action="Delete" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Confirmar Exclusão
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>