@model VianaMotos.Web.Models.Marca
@{
    ViewData["Title"] = "Nova marca";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Catálogo",
    Title = "Nova marca",
    Subtitle = "Cadastre uma nova fabricante para o catálogo.",
    Icon = "bi-tags",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Voltar", Url = Url.Action("Index")!, Icon = "bi-arrow-left", IsPrimary = false } }
})


<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Ativa" class="form-check-input" />
        <label asp-for="Ativa" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</form>