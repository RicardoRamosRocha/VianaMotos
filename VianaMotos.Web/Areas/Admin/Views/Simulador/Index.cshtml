
@model VianaMotos.Web.ViewModels.SimuladorViewModel

@{
    ViewData["Title"] = "Simulador de Parcelas";

    var exibirResultado = ViewContext.ModelState.IsValid
        && Model.MotoId.HasValue
        && Model.Parcelas > 0
        && Model.ValorMoto > 0;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Comercial",
    Title = "Simulador de parcelas",
    Subtitle = "Construa uma condição de pagamento clara e apresente a melhor opção para o cliente.",
    Icon = "bi-calculator"
})

<div class="vm-simulator">

    <section class="vm-simulator__form-panel">

        <div class="vm-simulator__section-heading">
            <div class="vm-simulator__heading-icon">
                <i class="bi bi-sliders"></i>
            </div>

            <div>
                <span class="vm-simulator__kicker">CONDIÇÕES DA PROPOSTA</span>
                <h2>Monte a simulação</h2>
                <p>Informe os dados da negociação para calcular as parcelas.</p>
            </div>
        </div>

        <form asp-action="Index" method="post" class="vm-simulator__form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="vm-simulator__field">
                <label asp-for="MotoId" class="form-label">
                    Motocicleta
                </label>

                <div class="vm-simulator__input-wrap">
                    <i class="bi bi-bicycle"></i>

                    <select asp-for="MotoId"
                            asp-items="Model.Motos"
                            class="form-select">
                        <option value="">Selecione uma motocicleta</option>
                    </select>
                </div>

                <span asp-validation-for="MotoId"
                      class="text-danger">
                </span>
            </div>

            <div class="vm-simulator__field">
                <label asp-for="Entrada" class="form-label">
                    Valor da entrada
                </label>

                <div class="vm-simulator__money-input">
                    <span>R$</span>

                    <input asp-for="Entrada"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                </div>

                <span asp-validation-for="Entrada"
                      class="text-danger">
                </span>
            </div>

            <div class="vm-simulator__quick-options">
                <span>Entrada rápida</span>

                <div>
                    <button type="button"
                            class="vm-simulator__chip"
                            data-entry-percent="0">
                        Sem entrada
                    </button>

                    <button type="button"
                            class="vm-simulator__chip"
                            data-entry-percent="10">
                        10%
                    </button>

                    <button type="button"
                            class="vm-simulator__chip"
                            data-entry-percent="20">
                        20%
                    </button>

                    <button type="button"
                            class="vm-simulator__chip"
                            data-entry-percent="30">
                        30%
                    </button>

                    <button type="button"
                            class="vm-simulator__chip"
                            data-entry-percent="50">
                        50%
                    </button>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="vm-simulator__field">
                        <label asp-for="TaxaMensal" class="form-label">
                            Taxa mensal
                        </label>

                        <div class="vm-simulator__suffix-input">
                            <input asp-for="TaxaMensal"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control" />

                            <span>%</span>
                        </div>

                        <span asp-validation-for="TaxaMensal"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="vm-simulator__field">
                        <label asp-for="Parcelas" class="form-label">
                            Número de parcelas
                        </label>

                        <input asp-for="Parcelas"
                               type="number"
                               min="1"
                               step="1"
                               class="form-control" />

                        <span asp-validation-for="Parcelas"
                              class="text-danger">
                        </span>
                    </div>
                </div>

            </div>

            <div class="vm-simulator__terms">
                <span>Escolha um prazo</span>

                <div class="vm-simulator__term-grid">
                    @foreach (var prazo in new[] { 12, 18, 24, 36, 48 })
                    {
                        <button type="button"
                                class="vm-simulator__term @(Model.Parcelas == prazo ? "is-active" : "")"
                                data-installments="@prazo">
                            <strong>@prazo</strong>
                            <small>parcelas</small>
                        </button>
                    }
                </div>
            </div>

            <button type="submit"
                    class="orizon-button orizon-button--primary vm-simulator__submit">
                <i class="bi bi-calculator"></i>
                Calcular simulação
                <i class="bi bi-arrow-right"></i>
            </button>

        </form>

    </section>


    <section class="vm-simulator__result-panel">

        @if (exibirResultado)
        {
            <div class="vm-simulator__result-top">
                <div>
                    <span class="vm-simulator__result-kicker">
                        SUA SIMULAÇÃO
                    </span>

                    <h2>Condição estimada</h2>

                    <p>
                        Confira os valores antes de apresentar a proposta ao cliente.
                    </p>
                </div>

                <div class="vm-simulator__result-status">
                    <i class="bi bi-check-circle-fill"></i>
                    Calculada
                </div>
            </div>

            <div class="vm-simulator__installment-hero">

                <span>Parcela estimada</span>

                <div class="vm-simulator__installment-value">
                    <small>@Model.Parcelas x</small>

                    <strong>
                        @Model.ValorParcela.ToString("C")
                    </strong>
                </div>

                <p>por mês</p>

            </div>

            <div class="vm-simulator__summary">

                <div class="vm-simulator__summary-item">
                    <span>Valor da moto</span>
                    <strong>@Model.ValorMoto.ToString("C")</strong>
                </div>

                <div class="vm-simulator__summary-item">
                    <span>Entrada</span>
                    <strong>@Model.Entrada.ToString("C")</strong>
                </div>

                <div class="vm-simulator__summary-item vm-simulator__summary-item--featured">
                    <span>Valor financiado</span>
                    <strong>@Model.ValorFinanciado.ToString("C")</strong>
                </div>

                <div class="vm-simulator__summary-item">
                    <span>Taxa mensal</span>
                    <strong>@Model.TaxaMensal.ToString("N2")%</strong>
                </div>

                <div class="vm-simulator__summary-item">
                    <span>Total de juros</span>
                    <strong>@Model.TotalJuros.ToString("C")</strong>
                </div>

                <div class="vm-simulator__summary-item">
                    <span>Total estimado</span>
                    <strong>@Model.TotalPago.ToString("C")</strong>
                </div>

            </div>

            <div class="vm-simulator__notice">
                <i class="bi bi-info-circle"></i>

                <p>
                    Esta é uma simulação comercial. As condições definitivas
                    dependem da análise e aprovação da instituição financeira.
                </p>
            </div>
        }
        else
        {
            <div class="vm-simulator__empty">

                <div class="vm-simulator__empty-icon">
                    <i class="bi bi-calculator"></i>
                </div>

                <span>SIMULAÇÃO COMERCIAL</span>

                <h2>Encontre uma parcela que cabe no orçamento</h2>

                <p>
                    Selecione a motocicleta, informe a entrada, a taxa e o prazo.
                    O resumo da proposta aparecerá aqui.
                </p>

                <div class="vm-simulator__empty-steps">

                    <div>
                        <strong>01</strong>
                        <span>Escolha a moto</span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                    <div>
                        <strong>02</strong>
                        <span>Defina a condição</span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                    <div>
                        <strong>03</strong>
                        <span>Apresente a parcela</span>
                    </div>

                </div>

            </div>
        }

    </section>

</div>


@section Scripts {

    <script>
        (() => {

            const parcelasInput = document.getElementById('Parcelas');
            const entradaInput = document.getElementById('Entrada');
            const motoSelect = document.getElementById('MotoId');

            const valoresMotos = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.ValoresMotos)
            );

            // -----------------------------
            // PRAZOS
            // -----------------------------

            const termButtons =
                document.querySelectorAll('[data-installments]');

            termButtons.forEach(button => {

                button.addEventListener('click', () => {

                    if (!parcelasInput)
                        return;

                    parcelasInput.value =
                        button.dataset.installments;

                    termButtons.forEach(item =>
                        item.classList.remove('is-active'));

                    button.classList.add('is-active');
                });

            });


            // -----------------------------
            // ENTRADA RÁPIDA
            // -----------------------------

            const entryButtons =
                document.querySelectorAll('[data-entry-percent]');

            entryButtons.forEach(button => {

                button.addEventListener('click', () => {

                    if (!motoSelect || !entradaInput)
                        return;

                    const motoId = motoSelect.value;

                    if (!motoId || !valoresMotos[motoId]) {
                        motoSelect.focus();
                        return;
                    }

                    const valorMoto =
                        Number(valoresMotos[motoId]);

                    const percentual =
                        Number(button.dataset.entryPercent);

                    const entrada =
                        valorMoto * (percentual / 100);

                    entradaInput.value =
                        entrada.toFixed(2);

                    entryButtons.forEach(item =>
                        item.classList.remove('is-active'));

                    button.classList.add('is-active');
                });

            });


            // Se o usuário alterar manualmente a entrada,
            // removemos a seleção automática.

            entradaInput?.addEventListener('input', () => {

                entryButtons.forEach(item =>
                    item.classList.remove('is-active'));

            });


            // Ao trocar a motocicleta, a entrada anterior
            // deixa de representar aquela negociação.

            motoSelect?.addEventListener('change', () => {

                if (entradaInput)
                    entradaInput.value = '0.00';

                entryButtons.forEach(item =>
                    item.classList.remove('is-active'));

            });

        })();
    </script>

}