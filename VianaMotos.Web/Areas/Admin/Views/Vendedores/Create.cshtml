@model VianaMotos.Web.Models.Vendedor

@{
    ViewData["Title"] = "Novo Vendedor";
}

<div class="admin-container">
    @await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Comercial",
    Title = "Novo vendedor",
    Subtitle = "Inclua um novo profissional na equipe comercial da Viana Motos.",
    Icon = "bi-person-plus",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Voltar", Url = Url.Action("Index")!, Icon = "bi-arrow-left", IsPrimary = false } }
})

    <section class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <h2 class="section-title">Dados do vendedor</h2>
            <p class="text-muted mb-4">Informe os dados de identificação e contato do profissional.</p>

            <div class="row g-4">
                <div class="col-lg-8">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" autocomplete="name" autofocus />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="col-lg-4">
                    <label asp-for="Cpf" class="form-label"></label>
                    <input asp-for="Cpf" class="form-control" inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" />
                    <span asp-validation-for="Cpf" class="text-danger"></span>
                </div>
                <div class="col-lg-6">
                    <label asp-for="Telefone" class="form-label"></label>
                    <input asp-for="Telefone" class="form-control" type="tel" autocomplete="tel" placeholder="(00) 00000-0000" />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>
                <div class="col-lg-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="vendedor@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="toolbar mt-4 pt-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Salvar Vendedor</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
