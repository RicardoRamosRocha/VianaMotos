@model VianaMotos.Web.ViewModels.PageHeaderViewModel

<section class="vm-page-header">

    <div class="vm-page-header__main">

        <div class="vm-page-header__icon" aria-hidden="true">
            <i class="bi @Model.Icon"></i>
        </div>

        <div class="vm-page-header__content">

            <div class="vm-page-header__eyebrow">
                <span class="vm-page-header__eyebrow-mark"></span>
                <span>@Model.Eyebrow</span>
            </div>

            <h1 class="vm-page-header__title">
                @Model.Title
            </h1>

            <p class="vm-page-header__subtitle">
                @Model.Subtitle
            </p>

        </div>

    </div>

    @if (Model.Actions.Count > 0)
    {
        <div class="vm-page-header__actions"
             aria-label="Ações da página">

            @foreach (var action in Model.Actions)
            {
                <a href="@action.Url" class="@(action.IsPrimary
                       ? "orizon-button orizon-button--primary vm-page-header__action vm-page-header__action--primary"
                       : "orizon-button orizon-button--secondary vm-page-header__action vm-page-header__action--secondary")"
                   target="@action.Target">

                    <i class="bi @action.Icon" aria-hidden="true"></i>
                    <span>@action.Text</span>

                </a>
            }

        </div>
    }

</section>