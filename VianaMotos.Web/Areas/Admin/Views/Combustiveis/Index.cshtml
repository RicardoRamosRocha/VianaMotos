@model IEnumerable<VianaMotos.Web.Models.Combustivel>
@{
    ViewData["Title"] = "Combustíveis";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Catálogo",
    Title = "Combustíveis",
    Subtitle = "Gerencie os tipos de combustível disponíveis no catálogo.",
    Icon = "bi-fuel-pump",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Novo combustível", Url = Url.Action("Create")!, Icon = "bi-plus-lg", IsPrimary = true } }
})@{
    ViewData["Title"] = "CombustÃ­veis";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Catálogo",
    Title = "Combustíveis",
    Subtitle = "Gerencie os tipos de combustível disponíveis no catálogo.",
    Icon = "bi-fuel-pump",
        Actions = new[] { new PageHeaderActionViewModel { Text = "Novo combustível", Url = Url.Action("Create")!, Icon = "bi-plus-lg", IsPrimary = true } }
})


<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ativa</th>
            <th width="200">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var combustivel in Model)
        {
            <tr>
                <td>@combustivel.Nome</td>
                <td>@combustivel.Ativo</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@combustivel.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@combustivel.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
